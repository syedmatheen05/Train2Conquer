# ======================================================================
# Train2Conquer settings.  Copy this file to ".env" for your own computer
# (the real .env is private and is NEVER uploaded to GitHub), and enter
# the same names as "Environment Variables" on your hosting website.
# Everything below is a PLACEHOLDER - put your own values after the "=".
# ======================================================================

# ---- 1. Mode ----------------------------------------------------------
# development = your computer (Razorpay TEST keys allowed)
# production  = the real website (Razorpay LIVE keys ONLY)
APP_ENV=development

# ---- 2. Website security ----------------------------------------------
# A long random text (30+ characters). Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# ---- 3. Database (Supabase / PostgreSQL connection URL) ---------------
SUPABASE=paste-your-database-url-here

# ---- 4. Razorpay ------------------------------------------------------
# Development: rzp_test_... keys.  Production: rzp_live_... keys ONLY.
RAZORPAY_KEY_ID=paste-your-razorpay-key-id-here
RAZORPAY_KEY_SECRET=paste-your-razorpay-key-secret-here
# Razorpay Dashboard -> Settings -> Webhooks (URL: https://YOUR-SITE/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=paste-your-webhook-secret-here

# ---- 5. AI providers --------------------------------------------------
GEMINI_API_KEY=paste-your-gemini-key-here
OPENAI_API_KEY=paste-your-openai-key-here
# Model names for the paid plans (never shown to customers)
PERSONALIZED_PLAN_MODEL=gpt-6-luna
ADVANCED_PLAN_MODEL=gpt-6.1-sol

# ---- 6. Money settings ------------------------------------------------
# Rupees per 1 US dollar, used to show OpenAI costs in rupees. Update when you like.
OPENAI_USD_TO_INR=90
# Safety limits so the AI bill can never run away
OPENAI_DAILY_LIMIT_USD=5.00
OPENAI_PER_GENERATION_LIMIT_USD=0.50
PAID_AI_MAX_ATTEMPTS=2
PAID_AI_MAX_OUTPUT_TOKENS=9000
# Optional: prices in paise (500 = Rs 5, 1500 = Rs 15). Defaults are already these.
# PERSONALIZED_PRICE_PAISE=500
# ADVANCED_PRICE_PAISE=1500

# ---- 7. Background work -----------------------------------------------
# inline = website builds plans itself (simplest, one server)
# worker = a second process (python worker.py) builds plans (recommended)
GENERATION_MODE=inline

# ---- 8. Email (OTP) and admin -----------------------------------------
# Gmail address + Gmail "App Password" used to send OTP emails
EMAIL=paste-your-sending-email-address-here
PASSWORD=paste-your-email-app-password-here
# Optional: this email address becomes an admin when it signs up/logs in
# ADMIN_EMAIL=you@example.com

# ---- 9. Optional extras -----------------------------------------------
# AUTO_MIGRATE=1        let the site upgrade its own database on start (skip the backup step!)
# RATELIMIT_STORAGE_URI=redis://...   shared rate limiting when you run several servers
# MAX_GENERATION_ATTEMPTS=3  MAX_PAID_PLANS_PER_DAY=10  MAX_BASIC_PLANS_PER_DAY=3
